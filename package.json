{
  "name": "goesm.dev",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.9.1",
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "build:cf": "astro build && wrangler build --experimental-new-config --experimental-cf-build-output",
    "preview:cf": "wrangler dev --experimental-new-config",
    "deploy": "pnpm run build:cf && cf deploy --prebuilt",
    "test": "go test ./... && astro build && node --test tests/"
  },
  "dependencies": {
    "@astrojs/vue": "7.0.3",
    "@gosfc/astro": "workspace:*",
    "astro": "7.3.5",
    "vue": "3.5.43"
  },
  "devDependencies": {
    "cf": "1.0.0-beta.12",
    "wrangler": "4.147.0"
  }
}
