---
import { Routes } from "go:goesm.dev/site";
import Layout from "../theme/Layout.astro";

// Every Markdown page of the content tree, as the Go engine lists them.
// This frontmatter stays TypeScript: getStaticPaths is an export, and a Go
// frontmatter cannot export anything.
export function getStaticPaths() {
  return Routes().map((r) => ({ params: { slug: r.slug || undefined }, props: { route: r.route } }));
}

const { route } = Astro.props;
---

<Layout route={route} />
